### `.github/actions/oc-login/action.yaml`
```yaml
name: 'OC Login'
description: 'Authenticate to OpenShift cluster using a service account token'
inputs:
  server-url:
    required: true
  token:
    required: true
  namespace:
    required: true
runs:
  using: "composite"
  steps:
    - name: Install oc CLI
      shell: bash
      run: |
        if ! command -v oc &> /dev/null; then
          curl -sLo oc.tar.gz https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable/openshift-client-linux.tar.gz
          tar -xzf oc.tar.gz oc
          sudo mv oc /usr/local/bin/oc
        fi
        oc version --client

    - name: Login to OpenShift
      shell: bash
      run: |
        oc login --token="${{ inputs.token }}" --server="${{ inputs.server-url }}"
        oc project "${{ inputs.namespace }}"
```

### `.github/workflows/bootstrap-environment.yaml`
```yaml
name: 1 - Environment Bootstrap

on:
  workflow_dispatch:
    inputs:
      microservice:
        description: 'Microservice name'
        required: true
        type: choice
        options:
          - customer-journey-bff
          - account-bff
          - payment-bff
          # ... rest of the 19
      environment:
        description: 'Target environment'
        required: true
        type: choice
        options:
          - uat
          - prod
      namespace:
        description: 'OpenShift namespace'
        required: true
        type: string

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate path exists
        run: |
          DIR="${{ inputs.microservice }}/${{ inputs.environment }}"
          if [ ! -d "$DIR" ]; then
            echo "::error::Directory $DIR does not exist"
            exit 1
          fi
          for f in deployment.yaml service.yaml route.yaml; do
            if [ ! -f "$DIR/$f" ]; then
              echo "::error::Missing $DIR/$f"
              exit 1
            fi
          done

      - name: Validate namespace format
        run: |
          if ! [[ "${{ inputs.namespace }}" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
            echo "::error::Invalid namespace format"
            exit 1
          fi

  bootstrap:
    needs: validate
    runs-on: ubuntu-latest
    environment: ${{ inputs.environment }}
    steps:
      - uses: actions/checkout@v4

      - name: OC Login
        uses: ./.github/actions/oc-login
        with:
          server-url: ${{ secrets.OPENSHIFT_SERVER }}
          token: ${{ secrets.OPENSHIFT_TOKEN }}
          namespace: ${{ inputs.namespace }}

      - name: Create placeholder secrets
        run: |
          chmod +x scripts/create-secrets.sh
          ./scripts/create-secrets.sh "${{ inputs.namespace }}"

      - name: Apply resources
        run: |
          chmod +x scripts/bootstrap.sh
          ./scripts/bootstrap.sh \
            "${{ inputs.microservice }}" \
            "${{ inputs.environment }}" \
            "${{ inputs.namespace }}"

      - name: Summary
        run: |
          echo "### Bootstrap Complete :rocket:" >> $GITHUB_STEP_SUMMARY
          echo "- Microservice: \`${{ inputs.microservice }}\`" >> $GITHUB_STEP_SUMMARY
          echo "- Environment: \`${{ inputs.environment }}\`" >> $GITHUB_STEP_SUMMARY
          echo "- Namespace: \`${{ inputs.namespace }}\`" >> $GITHUB_STEP_SUMMARY
          echo "- Secrets: \`application-profile\`, \`keystore\` (placeholder — populate manually)" >> $GITHUB_STEP_SUMMARY
```

### `scripts/create-secrets.sh`
```bash
#!/usr/bin/env bash
set -euo pipefail

NAMESPACE="$1"

echo "Ensuring placeholder secrets exist in namespace ${NAMESPACE}..."

# Secret 1: application-profile -> mounted at /app/config
oc create secret generic application-profile \
  --from-literal=application-uat.yml="# placeholder - populate manually" \
  --dry-run=client -o yaml | oc apply -f - -n "${NAMESPACE}"

# Secret 2: keystore -> mounted at /app/ssl
oc create secret generic keystore \
  --from-literal=keystore.jks="placeholder" \
  --dry-run=client -o yaml | oc apply -f - -n "${NAMESPACE}"

echo "Secrets ensured:"
oc get secrets application-profile keystore -n "${NAMESPACE}"
```

### `scripts/bootstrap.sh`
```bash
#!/usr/bin/env bash
set -euo pipefail

MICROSERVICE="$1"
ENVIRONMENT="$2"
NAMESPACE="$3"
DIR="${MICROSERVICE}/${ENVIRONMENT}"

echo "Bootstrapping ${MICROSERVICE} into namespace ${NAMESPACE} (${ENVIRONMENT})"

oc project "${NAMESPACE}"

for resource in deployment service route; do
  FILE="${DIR}/${resource}.yaml"
  echo "Applying ${FILE}..."
  oc apply -f "${FILE}" -n "${NAMESPACE}"
done

echo "Waiting for deployment rollout..."
APP_NAME=$(oc apply -f "${DIR}/deployment.yaml" -n "${NAMESPACE}" --dry-run=client -o jsonpath='{.metadata.name}')
oc rollout status "deployment/${APP_NAME}" -n "${NAMESPACE}" --timeout=300s

echo "Bootstrap complete for ${MICROSERVICE} in ${NAMESPACE}"
```

### `.github/workflows/application-release.yaml`
```yaml
name: 2 - Application Release

on:
  workflow_dispatch:
    inputs:
      microservice:
        required: true
        type: choice
        options:
          - customer-journey-bff
          - account-bff
          - payment-bff
      environment:
        required: true
        type: choice
        options:
          - uat
          - prod
      namespace:
        required: true
        type: string
      image_repository:
        description: 'e.g. ghcr.io/company/customer-journey-bff'
        required: true
        type: string
      image_tag:
        description: 'e.g. v1.2.5'
        required: true
        type: string

permissions:
  contents: write

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate deployment file exists
        run: |
          FILE="${{ inputs.microservice }}/${{ inputs.environment }}/deployment.yaml"
          test -f "$FILE" || { echo "::error::$FILE not found"; exit 1; }

      - name: Validate image tag format
        run: |
          if [[ "${{ inputs.image_tag }}" == "latest" ]]; then
            echo "::error::Refusing to deploy 'latest' tag — use immutable tags"
            exit 1
          fi

  update-manifest:
    needs: validate
    runs-on: ubuntu-latest
    outputs:
      app_name: ${{ steps.appname.outputs.app_name }}
    steps:
      - uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Update image in deployment.yaml
        run: |
          chmod +x scripts/release.sh
          ./scripts/release.sh update-image \
            "${{ inputs.microservice }}" \
            "${{ inputs.environment }}" \
            "${{ inputs.image_repository }}" \
            "${{ inputs.image_tag }}"

      - id: appname
        run: |
          FILE="${{ inputs.microservice }}/${{ inputs.environment }}/deployment.yaml"
          NAME=$(yq '.metadata.name' "$FILE")
          echo "app_name=$NAME" >> "$GITHUB_OUTPUT"

      - name: Commit and push
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          FILE="${{ inputs.microservice }}/${{ inputs.environment }}/deployment.yaml"
          git add "$FILE"
          git commit -m "deploy(${{ inputs.environment }}): ${{ inputs.microservice }} -> ${{ inputs.image_tag }}" || echo "No changes to commit"
          git push

  deploy:
    needs: update-manifest
    runs-on: ubuntu-latest
    environment: ${{ inputs.environment }}
    steps:
      - uses: actions/checkout@v4

      - name: OC Login
        uses: ./.github/actions/oc-login
        with:
          server-url: ${{ secrets.OPENSHIFT_SERVER }}
          token: ${{ secrets.OPENSHIFT_TOKEN }}
          namespace: ${{ inputs.namespace }}

      - name: Apply updated deployment
        run: |
          FILE="${{ inputs.microservice }}/${{ inputs.environment }}/deployment.yaml"
          oc apply -f "$FILE" -n "${{ inputs.namespace }}"

      - name: Wait for rollout
        run: |
          oc rollout status "deployment/${{ needs.update-manifest.outputs.app_name }}" \
            -n "${{ inputs.namespace }}" --timeout=300s

      - name: Verify pods healthy
        run: |
          oc get pods -n "${{ inputs.namespace }}" \
            -l app="${{ needs.update-manifest.outputs.app_name }}" \
            -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.status.phase}{"\n"}{end}'

      - name: Rollback on failure
        if: failure()
        run: |
          echo "::warning::Rollout failed, rolling back"
          oc rollout undo "deployment/${{ needs.update-manifest.outputs.app_name }}" -n "${{ inputs.namespace }}"

      - name: Summary
        if: success()
        run: |
          echo "### Release Complete :white_check_mark:" >> $GITHUB_STEP_SUMMARY
          echo "- Image: \`${{ inputs.image_repository }}:${{ inputs.image_tag }}\`" >> $GITHUB_STEP_SUMMARY
          echo "- Namespace: \`${{ inputs.namespace }}\`" >> $GITHUB_STEP_SUMMARY
```

### `scripts/release.sh`
```bash
#!/usr/bin/env bash
set -euo pipefail

COMMAND="$1"

update_image() {
  local MICROSERVICE="$1"
  local ENVIRONMENT="$2"
  local IMAGE_REPO="$3"
  local IMAGE_TAG="$4"
  local FILE="${MICROSERVICE}/${ENVIRONMENT}/deployment.yaml"
  local NEW_IMAGE="${IMAGE_REPO}:${IMAGE_TAG}"

  echo "Updating ${FILE} image to ${NEW_IMAGE}"
  yq -i ".spec.template.spec.containers[0].image = \"${NEW_IMAGE}\"" "$FILE"

  echo "Updated:"
  yq '.spec.template.spec.containers[0].image' "$FILE"
}

case "$COMMAND" in
  update-image)
    shift
    update_image "$@"
    ;;
  *)
    echo "Unknown command: $COMMAND"
    exit 1
    ;;
esac
```

